# Copia este archivo como .env y pon los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API). El archivo .env no se sube al repositorio.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_publica

# Puerto local para docker compose (opcional)
PORT=8080
